# Manual workflows require no environment variables.

# OpenAI-compatible plan generation and textual step execution
# API_KEY=replace-with-provider-key
# API_URL=https://provider.example/v1
# API_MODEL=replace-with-model-name

# Seeds the planner prompt only when no prompt is stored yet
# PLANNER_PLAN_SYSTEM_PROMPT=Create a concise ordered plan for the task.

# Optional OpenAI-compatible request tuning
# PLANNER_OPENAI_TIMEOUT_SECONDS=30
# STEP_EXECUTOR_OPENAI_TIMEOUT_SECONDS=60
# STEP_EXECUTOR_OPENAI_TEMPERATURE=0.2

# Optional Codex CLI and tmux executor
# CODEX_ENABLED=false
# CODEX_COMMAND=codex
# CODEX_WORKING_DIRECTORY=/path/to/trusted/project
# CODEX_CALLBACK_BASE_URL=http://127.0.0.1:8000
# CODEX_CALLBACK_SECRET=replace-with-a-long-random-secret
# CODEX_TMUX_SESSION_PREFIX=longagent
# CODEX_TIMEOUT_SECONDS=1200
# CODEX_MAX_ATTEMPTS=2
# CODEX_KEEPALIVE_INTERVAL_SECONDS=30

# Current defaults are permissive; review these before enabling Codex.
# CODEX_SANDBOX=danger-full-access
# CODEX_APPROVAL_POLICY=never
